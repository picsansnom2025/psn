{% doc %}
  @prompt
    「新增 section」增加Judge.me 添加评论组件, 我的意思是嵌入Judge.me这个应用程序 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-app-embed-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-app-embed-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-app-embed-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-app-embed-title-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
  }

  {% if block.settings.show_title %}
    .ai-app-embed-{{ ai_gen_id }} .jm-review-widget-minimal-header__title {
      display: none;
    }
  {% endif %}

  #judgeme_product_reviews,
  #judgeme_product_reviews .jm-review-widget {
    --jm-review-widget-text-color: var(--color-foreground) !important;
    --jm-review-widget-lighter-text-color: rgba(var(--color-foreground-rgb), 0.55) !important;
    --jm-review-widget-star-and-histogram-color: var(--color-foreground) !important;
    --jm-review-widget-button-color: transparent !important;
    --jm-review-widget-button-text-color: var(--color-foreground) !important;
    --jm-widget-primary-color: var(--color-foreground) !important;
    --jm-review-widget-form-button-color: var(--color-foreground) !important;
    --jm-review-widget-form-button-text-color: var(--color-background) !important;
    --jm-review-widget-form-text-color: var(--color-foreground) !important;
    --jm-review-widget-form-field-background-color: var(--color-background) !important;
    --jm-review-widget-form-border-radius: 0px !important;
    --jm-widget-border-radius: 0px !important;
    --jm-widget-border-radius-simplified: 0px !important;
    color: var(--color-foreground);
  }

  #judgeme_product_reviews .jm-text,
  #judgeme_product_reviews .jm-button,
  #judgeme_product_reviews .jdgm-sort-dropdown,
  .jdgm-write-review-modal,
  .jdgm-write-review-modal__title,
  .jdgm-write-review-modal__intro,
  .jdgm-write-review-modal__product-title,
  .jdgm-write-review-modal__field-label,
  .jdgm-write-review-modal__field-input,
  .jdgm-write-review-modal__btn {
    font-family: var(--font-body-family) !important;
  }

  #judgeme_product_reviews .jm-reviewer-info__name,
  #judgeme_product_reviews .jm-review-content__title,
  #judgeme_product_reviews .jm-review-content__body,
  #judgeme_product_reviews .jm-average-rating-display {
    color: var(--color-foreground);
  }

  #judgeme_product_reviews .jm-reviewer-info__details .jm-text:not(.jm-reviewer-info__name) {
    color: rgba(var(--color-foreground-rgb), 0.55);
  }

  #judgeme_product_reviews .jm-review-item {
    border-color: rgba(var(--color-foreground-rgb), 0.15);
    animation: psn-review-item-in 320ms ease;
  }

  #judgeme_product_reviews .jm-reviewer-avatar,
  #judgeme_product_reviews .jm-reviewer-avatar__initial {
    background: rgba(var(--color-foreground-rgb), 0.06);
    color: var(--color-foreground);
  }

  #judgeme_product_reviews .jm-action-buttons__button {
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    transition: opacity 240ms ease;
  }

  #judgeme_product_reviews .jm-action-buttons__button:hover {
    opacity: 0.55;
  }

  #judgeme_product_reviews .jm-action-buttons__button:active {
    opacity: 0.35;
  }

  #judgeme_product_reviews .jm-button--secondary,
  #judgeme_product_reviews .jm-sort-filter,
  #judgeme_product_reviews .jdgm-sort-dropdown {
    border-radius: 0;
    color: var(--color-foreground);
    border-color: rgba(var(--color-foreground-rgb), 0.2);
    background: var(--color-background);
    transition: background-color 240ms ease, border-color 240ms ease;
  }

  #judgeme_product_reviews .jm-button--secondary:hover,
  #judgeme_product_reviews .jm-sort-filter:hover {
    background: rgba(var(--color-foreground-rgb), 0.04);
  }

  #judgeme_product_reviews .jm-button--secondary:active,
  #judgeme_product_reviews .jm-sort-filter:active {
    background: rgba(var(--color-foreground-rgb), 0.08);
  }

  #judgeme_product_reviews .jm-rating-filter__tag {
    gap: 6px;
    min-height: 44px;
    padding: 8px 16px;
    font-size: 15px;
    line-height: 1;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 240ms ease, color 240ms ease, border-color 240ms ease;
  }

  #judgeme_product_reviews .jm-rating-filter__star {
    font-size: 0;
    line-height: 1;
  }

  #judgeme_product_reviews .jm-rating-filter__star::before {
    content: "\e000";
    font-family: JudgemeStar, monospace;
    font-size: 22px;
    font-style: normal;
    line-height: 1;
    color: rgba(var(--color-foreground-rgb), 0.45);
    display: inline-block;
    transition: color 240ms ease, transform 240ms ease;
  }

  #judgeme_product_reviews .jm-rating-filter__tag:hover {
    border-color: var(--color-foreground);
  }

  #judgeme_product_reviews .jm-rating-filter__tag:hover .jm-rating-filter__star::before {
    color: var(--color-foreground);
    transform: scale(1.08);
  }

  #judgeme_product_reviews .jm-rating-filter__tag:has(input:checked),
  #judgeme_product_reviews .jm-rating-filter__tag--selected {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  #judgeme_product_reviews .jm-rating-filter__tag:has(input:checked) .jm-rating-filter__star::before,
  #judgeme_product_reviews .jm-rating-filter__tag--selected .jm-rating-filter__star::before {
    color: var(--color-background);
    transform: none;
  }

  .jdgm-write-review-modal {
    --jm-widget-primary-color: var(--color-foreground) !important;
    --jm-review-widget-form-button-color: var(--color-foreground) !important;
    --jm-review-widget-form-button-text-color: var(--color-background) !important;
    --jm-review-widget-form-text-color: var(--color-foreground) !important;
    --jm-review-widget-star-and-histogram-color: var(--color-foreground) !important;
    color: var(--color-foreground);
  }

  .jdgm-write-review-modal__content {
    border-radius: 0;
    color: var(--color-foreground);
  }

  .jdgm-write-review-modal__field-input {
    border-radius: 0;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    background: var(--color-background);
    color: var(--color-foreground);
    transition: border-color 240ms ease;
  }

  .jdgm-write-review-modal__field-input:focus {
    border-color: var(--color-foreground);
  }

  .jdgm-write-review-modal[style*="display: block"] .jdgm-write-review-modal__overlay,
  .jdgm-write-review-modal[style*="display: flex"] .jdgm-write-review-modal__overlay {
    animation: psn-review-overlay-in 280ms ease;
  }

  .jdgm-write-review-modal[style*="display: block"] .jdgm-write-review-modal__content,
  .jdgm-write-review-modal[style*="display: flex"] .jdgm-write-review-modal__content {
    animation: psn-review-panel-in 320ms ease;
  }

  .jdgm-write-review-modal__btn,
  .jdgm-write-review-modal__nav-btn-next,
  .jdgm-write-review-modal__nav-btn-close {
    border-radius: 0 !important;
    background: var(--color-foreground) !important;
    color: var(--color-background) !important;
    border: 0 !important;
    transition: opacity 240ms ease;
  }

  .jdgm-write-review-modal__btn:hover,
  .jdgm-write-review-modal__nav-btn-next:hover,
  .jdgm-write-review-modal__nav-btn-close:hover {
    opacity: 0.82;
  }

  .jdgm-write-review-modal__btn--repeat-not-now {
    background: transparent !important;
    color: var(--color-foreground) !important;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .jdgm-write-review-modal .jdgm-star {
    color: var(--color-foreground) !important;
    transition: color 240ms ease, transform 240ms ease;
  }

  .jdgm-write-review-modal .jdgm-star.jdgm--off {
    color: rgba(var(--color-foreground-rgb), 0.28) !important;
  }

  .jdgm-write-review-modal .jdgm-star:hover {
    transform: scale(1.08);
  }

  @keyframes psn-review-item-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes psn-review-overlay-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes psn-review-panel-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #judgeme_product_reviews .jm-review-item,
    .jdgm-write-review-modal__overlay,
    .jdgm-write-review-modal__content {
      animation: none;
    }

    .jdgm-write-review-modal .jdgm-star,
    #judgeme_product_reviews .jm-rating-filter__star::before {
      transform: none;
      transition: color 240ms ease;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-app-embed-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-app-embed-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-app-embed-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-app-embed-container-{{ ai_gen_id }}">
    {% if block.settings.show_title and block.settings.title != blank %}
      <div class="ai-app-embed-header-{{ ai_gen_id }}">
        <h2 class="ai-app-embed-title-{{ ai_gen_id }}">
          {{ block.settings.title }}
        </h2>
      </div>
    {% endif %}

    {% assign review_product = closest.product | default: product %}
    {% assign has_legacy_widget = false %}
    {% if review_product.metafields.judgeme.widget.size > 20 %}
      {% assign has_legacy_widget = true %}
    {% endif %}
    <div style="clear:both"></div>
    <div
      id="judgeme_product_reviews"
      class="jdgm-widget jdgm-review-widget"
      data-product-title="{{ review_product.title | escape }}"
      data-id="{{ review_product.id }}"
      data-product-id="{{ review_product.id }}"
      data-widget="review"
      data-auto-install="false"
      data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
      data-entry-point="review_widget.js"
      data-entry-key="review-widget/main.js"
    >
      {% if has_legacy_widget %}
        <div class="jdgm-legacy-widget-content" style="display: none;">
          {{ review_product.metafields.judgeme.widget }}
        </div>
      {% endif %}
    </div>
    {% if review_product.metafields.judgeme.review_widget_data %}
      <script>
        jdgm.data ||= {};
        jdgm.data.reviewWidget ||= {};
        jdgm.data.reviewWidget[{{ review_product.id }}] = {{ review_product.metafields.judgeme.review_widget_data }};
      </script>
    {% endif %}
    <script>
      (function () {
        var productId = {{ review_product.id }};
        var attempts = 0;

        function cachedCount() {
          var data = window.jdgm && jdgm.data && jdgm.data.reviewWidget && jdgm.data.reviewWidget[productId];
          return (data && Number(data.number_of_reviews)) || 0;
        }

        function widgetSrc() {
          var entries = performance.getEntriesByType('resource');
          var index = entries.length;
          while (index--) {
            if (/\/review_widget\.js(?:\?|$)/.test(entries[index].name)) {
              return entries[index].name.split('?')[0];
            }
          }
          return '';
        }

        function tick() {
          var box = document.getElementById('judgeme_product_reviews');
          if (!box || !window.jdgm || !box.__vue_app__) {
            if (attempts < 20) {
              attempts += 1;
              window.setTimeout(tick, 300);
            }
            return;
          }
          if (cachedCount() > 0 || box.dataset.psnReviewsFresh === '1') return;
          var src = widgetSrc();
          if (!src || !jdgm.shopDomain) return;
          fetch(
            'https://api.judge.me/reviews/reviews_for_widget?shop_domain=' +
              encodeURIComponent(jdgm.shopDomain()) +
              '&platform=shopify&product_id=' +
              productId +
              '&page=1'
          )
            .then(function (response) {
              return response.json();
            })
            .then(function (data) {
              if (!data || !data.number_of_reviews || data.number_of_reviews <= cachedCount()) return;
              jdgm.data ||= {};
              jdgm.data.reviewWidget ||= {};
              jdgm.data.reviewWidget[productId] = data;
              if (box.__vue_app__) box.__vue_app__.unmount();
              box.innerHTML = '';
              box.dataset.psnReviewsFresh = '1';
              return import(src + '?psn=' + Date.now());
            })
            .catch(function () {});
        }

        tick();
      })();
    </script>
  </div>
</div>

{% schema %}
{
  "name": "Judge.me 评论",
  "settings": [
    {
      "type": "paragraph",
      "content": "此区块将显示 Judge.me 应用的产品评论。请确保已安装并启用 Judge.me 应用。"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面端宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "最大宽度",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "标题"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "显示标题",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题文本",
      "default": "Customer Reviews",
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "标题字号",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "文本对齐",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "标题底部间距",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "左右边距",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Judge.me 评论"
    }
  ]
}
{% endschema %}
