<div class="section-container section-image-with-text iwt-{{ section.settings.section_size }} iwt-dt-layout-{{ section.settings.dt_image_width }} iwt-dt-img-position--{{ section.settings.image_alignment }} section-{{ section.id }} color-scheme-{{ section.settings.text_color }} color-scheme-{{ section.settings.bg_color }}">

{% if section.settings.top_border %}
<hr class="section-border section-border-color-{{ section.settings.border_color }} section-border-width-{{ section.settings.border_width }}">
{% endif %}
  
<div class="section-inner{% if section.settings.border_vertical %} iwt-vborder iwt-vborder-color-{{ section.settings.border_color }}{% endif %}">
<div class="image-with-text-content-container{% if section.settings.card_spacing > 0 or section.settings.inner_padding > 0 %} std-page-padding{% endif %} {{ section.settings.content_width | escape }} {{ card_space }}">

<div class="image-with-text--image image-ratio-{{ section.settings.image_ratio }}">

{% assign image_render_size = 1800 %}
{% if section.settings.dt_image_width < 50 %}
  {% assign image_render_size = 1600 %}
{% endif %}
{% if section.settings.dt_image_width < 60 %}
  {% assign image_render_size = 2000 %}
{% endif %}
{% assign iwt_slides = section.blocks | where: 'type', 'image' %}

<div class="image-cover-container">
{% if iwt_slides.size > 0 %}
{% if iwt_slides.size > 1 %}
<iwt-slideshow class="image-cover-wrapper iwt-slides" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.autoplay_speed | times: 1000 }}">
{% else %}
<div class="image-cover-wrapper iwt-slides">
{% endif %}
  {% for block in iwt_slides %}
  <div class="iwt-slide{% if forloop.first %} is-active{% endif %}" data-iwt-slide {{ block.shopify_attributes }}{% unless forloop.first %} aria-hidden="true"{% endunless %}>
    {% if block.settings.image %}
      {{ block.settings.image | image_url: width: image_render_size | image_tag: loading: 'lazy' }}
    {% else %}
      {% render 'media-placeholder-scenic', style: 1 %}
    {% endif %}
  </div>
  {% endfor %}
  {% if iwt_slides.size > 1 %}
  <div class="iwt-slide-controls">
    <button type="button" class="iwt-slide-btn iwt-slide-btn--prev" data-iwt-prev aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">{% render 'icon-arrow' %}</button>
    <div class="iwt-slide-dots">
      {% for block in iwt_slides %}
      <button type="button" class="iwt-slide-dot{% if forloop.first %} is-active{% endif %}" data-iwt-dot aria-label="{{ 'sections.slideshow.slide' | t }} {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
      {% endfor %}
    </div>
    <button type="button" class="iwt-slide-btn iwt-slide-btn--next" data-iwt-next aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">{% render 'icon-arrow' %}</button>
    <div class="iwt-slide-progress" data-iwt-progress aria-hidden="true"><span class="iwt-slide-progress-bar" data-iwt-progress-bar></span></div>
  </div>
</iwt-slideshow>
{% else %}
</div>
{% endif %}
{% elsif section.settings.image %}
<div class="image-cover-wrapper">
{{ section.settings.image | image_url: width: image_render_size | image_tag: loading: 'lazy' }}
</div>
{% else %}
<div class="image-cover-wrapper">
{% render 'media-placeholder-scenic', style: 1 %}
</div>
{% endif %}
</div>

</div>

<div class="image-with-text--text align-{{ section.settings.txt_alignment }} vertical-align--{{ section.settings.txt_vertical_alignment }} iwt-text-width--{{ section.settings.text_width }} iwt-text-hoz-position--{{ section.settings.text_horizontal_position }}">
<div class="image-with-text--content">
{% if section.settings.secondary_image %}
{% assign image_width = 400 %}
{% if section.settings.secondary_image_scale == 'medium' %}
{% assign image_width = 600 %}
{% endif %}
{% if section.settings.secondary_image_scale == 'large' %}
{% assign image_width = 800 %}
{% endif %}
<div class="image-with-text--inset-image inset-image-{{ section.settings.secondary_image_scale }}">
{{ section.settings.secondary_image | image_url: width: image_width | image_tag: loading: 'lazy' }}
</div> 
{% endif %}

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'caption' %}
    <div class="section-label" {{ block.shopify_attributes }}>{{ block.settings.caption }}</div>
    {% when 'heading' %}
    <h2 class="{{ block.settings.heading_size | escape }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
    {% when 'text' %}
    <div class="rte image-with-text-description text-{{ block.settings.text_size }}" {{ block.shopify_attributes }}>
      {{ block.settings.description }}
    </div>
    {% when 'button' %}
    <div class="image-with-text-footer button-width--{{ block.settings.button_width_mobile }}{% if block.settings.btn_two_enable %} image-with-text-footer--two-button layout-{{ block.settings.button_layout }}{% endif %} button-color-scheme--{{ block.settings.btn_color_scheme }}" {{ block.shopify_attributes }}>
    {% if block.settings.btn_style == 'solid' %}
	  <a href="{{ block.settings.btn_link }}" role="link" class="button button--solid">{{ block.settings.btn_txt }}</a>
    {% endif %}
    {% if block.settings.btn_style == 'outline' %}
	  <a href="{{ block.settings.btn_link }}" role="link" class="button button--outline">{{ block.settings.btn_txt }}</a>
    {% endif %}
    {% if block.settings.btn_style == 'link' %}
	  <a href="{{ block.settings.btn_link }}" role="link" class="link--underlined">{{ block.settings.btn_txt }}</a>
    {% endif %}

    {% if block.settings.btn_two_enable %}
    {% if block.settings.btn_two_style == 'solid' %}
	  <a href="{{ block.settings.btn_two_link }}" role="link" class="button button--solid iwt-secondary-button">{{ block.settings.btn_two_txt }}</a>
    {% endif %}
    {% if block.settings.btn_two_style == 'outline' %}
	  <a href="{{ block.settings.btn_two_link }}" role="link" class="button button--outline iwt-secondary-button">{{ block.settings.btn_two_txt }}</a>
    {% endif %}
    {% if block.settings.btn_two_style == 'link' %}
	  <a href="{{ block.settings.btn_two_link }}" role="link" class="link--underlined iwt-secondary-button">{{ block.settings.btn_two_txt }}</a>
    {% endif %}      
    {% endif %}
      
    </div>
  {% endcase %}
{% endfor %}

</div>
</div>
</div>
</div> 

{% if section.settings.bottom_border %}
<hr class="section-border section-border-color-{{ section.settings.border_color }} section-border-width-{{ section.settings.border_width }}">
{% endif %}
  
</div>

{% if iwt_slides.size > 1 %}
<script>
  if (!customElements.get('iwt-slideshow')) {
    class IwtSlideshow extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('[data-iwt-slide]'));
        this.dots = Array.from(this.querySelectorAll('[data-iwt-dot]'));
        this.index = Math.max(0, this.slides.findIndex((slide) => slide.classList.contains('is-active')));
        this.querySelector('[data-iwt-prev]')?.addEventListener('click', () => this.show(this.index - 1));
        this.querySelector('[data-iwt-next]')?.addEventListener('click', () => this.show(this.index + 1));
        this.dots.forEach((dot, index) => dot.addEventListener('click', () => this.show(index)));
        this.pointerX = null;
        this.autoplay = this.dataset.autoplay === 'true';
        this.interval = Number(this.dataset.interval) || 5000;
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.hovered = false;
        this.inView = false;
        this.playing = false;
        this.elapsed = 0;
        this.progressBar = this.querySelector('[data-iwt-progress-bar]');
        this.addEventListener('pointerdown', (event) => {
          if (event.target.closest('button')) return;
          this.pointerX = event.clientX;
        });
        this.addEventListener('pointerup', (event) => {
          if (this.pointerX == null) return;
          const delta = event.clientX - this.pointerX;
          this.pointerX = null;
          if (Math.abs(delta) < 40) return;
          this.show(this.index + (delta < 0 ? 1 : -1));
        });
        this.addEventListener('mouseenter', () => {
          this.hovered = true;
          this.pause();
        });
        this.addEventListener('mouseleave', () => {
          this.hovered = false;
          this.play();
        });
        this.onVisibility = () => {
          if (document.hidden) this.pause();
          else this.play();
        };
        document.addEventListener('visibilitychange', this.onVisibility);
        this.observer = new IntersectionObserver((entries) => {
          this.inView = entries.some((entry) => entry.isIntersecting);
          if (this.inView) this.play();
          else this.pause();
        }, { threshold: 0.4 });
        this.observer.observe(this);
      }

      disconnectedCallback() {
        this.pause();
        this.observer?.disconnect();
        document.removeEventListener('visibilitychange', this.onVisibility);
      }

      play() {
        if (!this.autoplay || this.reducedMotion || this.slides.length < 2) return;
        if (this.hovered || !this.inView || document.hidden || this.playing) return;
        this.playing = true;
        this.startedAt = performance.now() - this.elapsed;
        this.tick();
      }

      pause() {
        if (this.playing) {
          this.elapsed = performance.now() - this.startedAt;
          this.playing = false;
        }
        if (this.frame) cancelAnimationFrame(this.frame);
        this.frame = null;
      }

      tick() {
        if (!this.playing) return;
        const elapsed = performance.now() - this.startedAt;
        const progress = Math.min(elapsed / this.interval, 1);
        this.setProgress(progress);
        if (progress >= 1) {
          this.index = (this.index + 1) % this.slides.length;
          this.render();
          this.elapsed = 0;
          this.startedAt = performance.now();
          this.setProgress(0);
        }
        this.frame = requestAnimationFrame(() => this.tick());
      }

      setProgress(value) {
        if (this.progressBar) this.progressBar.style.transform = `scaleX(${value})`;
      }

      render() {
        this.slides.forEach((slide, slideIndex) => {
          const active = slideIndex === this.index;
          slide.classList.toggle('is-active', active);
          slide.toggleAttribute('aria-hidden', !active);
        });
        this.dots.forEach((dot, dotIndex) => {
          const active = dotIndex === this.index;
          dot.classList.toggle('is-active', active);
          if (active) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      }

      show(index) {
        const count = this.slides.length;
        if (!count) return;
        this.index = (index + count) % count;
        this.render();
        this.elapsed = 0;
        this.startedAt = performance.now();
        this.setProgress(0);
      }
    }

    customElements.define('iwt-slideshow', IwtSlideshow);
  }
</script>
{% endif %}

{% schema %}
  {
    "name": "t:sections.image-with-text.name",
  	"tag": "section",
  	"class": "section",    
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
    {
      "type": "header",
      "content": "t:sections.all.layout"
    },
    {
      "type": "select",
      "id": "section_size",
      "label": "t:sections.image-with-text.settings.section_height.label",
      "options": [
        {
          "value": "flexible",
          "label": "t:sections.image-with-text.settings.section_height.options__1.label"
        },
        {
          "value": "screen-height",
          "label": "t:sections.image-with-text.settings.section_height.options__2.label"
        }
        ],
      "default": "flexible"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.all.margin",
      "options": [
        {
          "value": "page-width",
          "label": "t:sections.all.default"
        },
        {
          "value": "page-width-full-grid",
          "label": "t:sections.all.full_width"
        }
		],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "t:sections.image-with-text.settings.desktop_image_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.alignment.left"
        },
        {
          "value": "right",
          "label": "t:sections.all.alignment.right"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "dt_image_width",
      "min": 30,
      "max": 70,
      "step": 10,
      "unit": "%",
      "default": 50,
      "label": "t:sections.image-with-text.settings.desktop_image_width.label",
      "info": "t:sections.image-with-text.settings.desktop_image_width.info"
    },
    {
      "type": "range",
      "id": "card_spacing",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 20,
      "label": "t:sections.all.layouts.horizontal_spacing"
    },
    {
      "type": "header",
      "content": "t:sections.all.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.main_image.label"
	},
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.all.ratio.image_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:sections.all.ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.ratio.portrait_4_5"
        },
        {
          "value": "portrait-4x6",
          "label": "t:sections.all.ratio.portrait_4_6"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.ratio.landscape"
        },
        {
          "value": "fit",
          "label": "t:sections.all.ratio.adapt_to_image"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.image-with-text.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "t:sections.image-with-text.settings.autoplay_speed.label",
      "default": 5
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "t:sections.image-with-text.settings.secondary_image.label"
	  },
    {
      "type": "select",
      "id": "secondary_image_scale",
      "label": "t:sections.image-with-text.settings.secondary_image_size.label",
      "options": [
        {
          "value": "micro",
          "label": "t:sections.all.size.micro"
        },
        {
          "value": "small",
          "label": "t:sections.all.size.small"
        },
        {
          "value": "medium",
          "label": "t:sections.all.size.medium"
        },
        {
          "value": "large",
          "label": "t:sections.all.size.large"
        }
		],
      "default": "small"
    },
    {
      "type": "header",
      "content": "t:sections.all.text"
    },
    {
      "type": "select",
      "id": "txt_alignment",
      "label": "t:sections.all.alignment.text_alignment_heading",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.alignment.left"
        },
        {
          "value": "center",
          "label": "t:sections.all.alignment.center"
        }
		],
      "default": "left"
    },
    {
      "type": "select",
      "id": "txt_vertical_alignment",
      "label": "t:sections.all.alignment.vertical_alignment",
      "info": "t:sections.all.devices.applies_desktop",
      "options": [
        {
          "value": "top",
          "label": "t:sections.all.alignment.top"
        },
        {
          "value": "middle",
          "label": "t:sections.all.alignment.middle"
        },
        {
          "value": "bottom",
          "label": "t:sections.all.alignment.bottom"
        }
		],
      "default": "middle"
    },
    {
      "type": "range",
      "id": "txt_padding_top_mobile",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20,
      "label": "t:sections.all.padding.padding_top_mobile"
    },
    {
      "type": "range",
      "id": "txt_padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 20,
      "label": "t:sections.all.padding.padding_bottom_mobile"
    },
    {
      "type": "range",
      "id": "txt_vertical_padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 0,
      "label": "t:sections.all.padding.padding_desktop"
    },
    {
      "type": "select",
      "id": "text_width",
      "label": "t:sections.all.width",
      "options": [
        {
          "value": "full",
          "label": "t:sections.all.full_width"
        },
        {
          "value": "medium",
          "label": "t:sections.all.size.medium"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.narrow"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "text_horizontal_position",
      "visible_if": "{{ section.settings.text_width != 'full' }}",
      "label": "t:sections.all.alignment.horizontal_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.alignment.left"
        },
        {
          "value": "center",
          "label": "t:sections.all.alignment.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "select",
      "id": "text_color",
      "options": [
        {
          "value": "fg-body",
          "label": "t:sections.all.colors.background_body.label"
        },
        {
          "value": "fg-01",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "fg-02",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "fg-03",
          "label": "t:sections.all.colors.accent_3.label"
        },
        {
          "value": "fg-04",
          "label": "t:sections.all.colors.accent_4.label"
        },
        {
          "value": "fg-05",
          "label": "t:sections.all.colors.accent_5.label"
        }
      ],
      "default": "fg-body",
      "label": "t:sections.all.colors.text_color.label"
    },
    {
      "type": "select",
      "id": "bg_color",
      "options": [
        {
          "value": "bg-body",
          "label": "t:sections.all.colors.background_body.label"
        },
        {
          "value": "bg-01",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "bg-02",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "bg-03",
          "label": "t:sections.all.colors.background_3.label"
        },
        {
          "value": "bg-04",
          "label": "t:sections.all.colors.background_4.label"
        },
        {
          "value": "bg-05",
          "label": "t:sections.all.colors.background_5.label"
        }
      ],
      "default": "bg-body",
      "label": "t:sections.all.colors.background_color.label"
    },
    {
      "type": "range",
      "id": "top_padding",
      "min": 0,
      "max": 160,
      "step": 10,
