{% comment %}
  Renders the size guide modal for the current product.

  Accepts:
  - product: {Object} product object with custom.size_guide metafield

  Usage:
  {% render 'size-guide-modal', product: product %}
{% endcomment %}

{% assign size_guide = product.metafields.custom.size_guide.value %}
{% assign measure_blocks = section.blocks | where: 'type', 'size_guide_measure' %}
{% assign fit_blocks = section.blocks | where: 'type', 'size_guide_fit' %}
{% assign measure_head = section.blocks | where: 'type', 'size_guide_measure_head' | first %}
{% assign fit_head = section.blocks | where: 'type', 'size_guide_fit_head' | first %}
{% assign size_guide_title = 'Size Guide' %}
{% if measure_blocks.size > 0 or fit_blocks.size > 0 %}
  {% if section.settings.size_guide_heading != blank %}
    {% assign size_guide_title = section.settings.size_guide_heading %}
  {% endif %}
{% elsif size_guide.product_type.value != blank %}
  {% assign size_guide_title = size_guide.product_type.value | append: ' Size Guide' %}
{% endif %}
{% if measure_blocks.size > 0 or fit_blocks.size > 0 or size_guide.measurements.value.headers or size_guide.womens_measurements.value.headers %}
{{ 'size-guide-modal.css' | asset_url | stylesheet_tag }}
<modal-dialog id="SizeGuideModal" class="product-popup-modal size-guide-modal">
  <div role="dialog" aria-label="{{ size_guide_title }}" aria-modal="true" class="product-popup-modal__content" tabindex="-1">
    <div class="modal-header">
      <button id="ModalClose-SizeGuide" type="button" class="product-popup-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-close' %}
      </button>
      <span class="dialog-title">{{ size_guide_title }}</span>
    </div>
    {% if size_guide.fit_description.value %}
      <p class="size-guide-modal__fit-description">{{ size_guide.fit_description.value }}</p>
    {% endif %}
    <div class="product-popup-modal__content-info size-guide-modal__body">
      {% if size_guide.silhouette_image.value %}
        <div class="size-guide-modal__image">
          {% assign sg_alt = size_guide.product_type.value | append: ' size guide diagram' %}
          {{ size_guide.silhouette_image.value | image_url: width: 800 | image_tag: loading: 'lazy', alt: sg_alt }}
        </div>
      {% endif %}
      {% assign measurements = size_guide.measurements.value %}
      {% assign womens_measurements = size_guide.womens_measurements.value %}
      {% assign product_gender = product.metafields.custom.product_gender.value %}
      {% assign has_mens = false %}
      {% assign has_womens = false %}
      {% if measurements.headers and measurements.rows %}
        {% assign has_mens = true %}
      {% endif %}
      {% if womens_measurements.headers and womens_measurements.rows %}
        {% assign has_womens = true %}
      {% endif %}

      {% if has_mens and has_womens %}
        {%- comment -%} Tabbed interface — both gendered tables {%- endcomment -%}
        {% assign womens_active = false %}
        {% if product_gender == "Women's" %}
          {% assign womens_active = true %}
        {% endif %}
        <div class="size-guide-modal__tabs" role="tablist">
          <button class="size-guide-modal__tab{% unless womens_active %} size-guide-modal__tab--active{% endunless %}"
                  data-tab="mens" type="button" role="tab"
                  aria-selected="{% if womens_active %}false{% else %}true{% endif %}"
                  aria-controls="sg-panel-mens"
                  id="sg-tab-mens">Men's</button>
          <button class="size-guide-modal__tab{% if womens_active %} size-guide-modal__tab--active{% endif %}"
                  data-tab="womens" type="button" role="tab"
                  aria-selected="{% if womens_active %}true{% else %}false{% endif %}"
                  aria-controls="sg-panel-womens"
                  id="sg-tab-womens">Women's</button>
        </div>
        <div class="size-guide-modal__tab-panel" data-panel="mens"
             role="tabpanel" id="sg-panel-mens" aria-labelledby="sg-tab-mens"
             {% if womens_active %}hidden{% endif %}>
          <div class="size-guide-modal__measurements">
            <table>
              <thead>
                <tr>
                  {% for header in measurements.headers %}
                    <th>{{ header }}</th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for row in measurements.rows %}
                  <tr>
                    {% for cell in row %}
                      <td>{{ cell }}</td>
                    {% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        <div class="size-guide-modal__tab-panel" data-panel="womens"
             role="tabpanel" id="sg-panel-womens" aria-labelledby="sg-tab-womens"
             {% unless womens_active %}hidden{% endunless %}>
          <div class="size-guide-modal__measurements">
            <table>
              <thead>
                <tr>
                  {% for header in womens_measurements.headers %}
                    <th>{{ header }}</th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for row in womens_measurements.rows %}
                  <tr>
                    {% for cell in row %}
                      <td>{{ cell }}</td>
                    {% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        <script src="{{ 'size-guide-tabs.js' | asset_url }}" defer="defer"></script>
      {% elsif has_mens %}
        {%- comment -%} Single table — men's only (backwards compatible) {%- endcomment -%}
        <div class="size-guide-modal__measurements">
          <table>
            <thead>
              <tr>
                {% for header in measurements.headers %}
                  <th>{{ header }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in measurements.rows %}
                <tr>
                  {% for cell in row %}
                    <td>{{ cell }}</td>
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% elsif has_womens %}
        {%- comment -%} Single table — women's only {%- endcomment -%}
        <div class="size-guide-modal__measurements">
          <table>
            <thead>
              <tr>
                {% for header in womens_measurements.headers %}
                  <th>{{ header }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in womens_measurements.rows %}
                <tr>
                  {% for cell in row %}
                    <td>{{ cell }}</td>
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% elsif measure_blocks.size > 0 or fit_blocks.size > 0 %}
        {% if measure_blocks.size > 0 %}
          <div class="size-guide-modal__measurements">
            <table>
              <thead>
                <tr {% if measure_head %}{{ measure_head.shopify_attributes }}{% endif %}>
                  <th>{% if measure_head %}{{ measure_head.settings.size }}{% else %}{{ section.settings.size_guide_col_size | default: 'Size' }}{% endif %}</th>
                  <th>{% if measure_head %}{{ measure_head.settings.hips }}{% else %}{{ section.settings.size_guide_col_hips | default: 'Hips (cm)' }}{% endif %}</th>
                  <th>{% if measure_head %}{{ measure_head.settings.waist }}{% else %}{{ section.settings.size_guide_col_waist | default: 'Waist (cm)' }}{% endif %}</th>
                  <th>{% if measure_head %}{{ measure_head.settings.bust }}{% else %}{{ section.settings.size_guide_col_bust | default: 'Bust (cm)' }}{% endif %}</th>
                  <th>{% if measure_head %}{{ measure_head.settings.thigh }}{% else %}{{ section.settings.size_guide_col_thigh | default: 'Thigh (cm)' }}{% endif %}</th>
                  <th>{% if measure_head %}{{ measure_head.settings.length }}{% else %}{{ section.settings.size_guide_col_length | default: 'Length (cm)' }}{% endif %}</th>
                </tr>
              </thead>
              <tbody>
                {% for row in measure_blocks %}
                  <tr {{ row.shopify_attributes }}>
                    <td>{{ row.settings.size }}</td>
                    <td>{{ row.settings.hips }}</td>
                    <td>{{ row.settings.waist }}</td>
                    <td>{{ row.settings.bust }}</td>
                    <td>{{ row.settings.thigh }}</td>
                    <td>{{ row.settings.length }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
        {% if fit_blocks.size > 0 %}
          {% capture fit_axis_height %}{% if fit_head %}{{ fit_head.settings.label }}{% else %}{{ section.settings.size_guide_height_label | default: 'Height (cm)' }}{% endif %}{% endcapture %}
          {% capture fit_axis_weight %}{% if fit_head %}{{ fit_head.settings.weight }}{% else %}{{ section.settings.size_guide_weight_label | default: 'Weight (kg)' }}{% endif %}{% endcapture %}
          <div class="size-guide-modal__measurements">
            {% unless section.settings.size_guide_corner_axis %}
              <p class="size-guide-modal__chart-label">{{ fit_axis_height | strip }}</p>
            {% endunless %}
            <table>
              <thead>
                <tr {% if fit_head %}{{ fit_head.shopify_attributes }}{% endif %}>
                  <th>
                    {% if section.settings.size_guide_corner_axis %}
                      <span class="size-guide-modal__corner">
                        <svg class="size-guide-modal__corner-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                          <line x1="0" y1="0" x2="100" y2="100"></line>
                        </svg>
                        <span class="size-guide-modal__corner-height">{{ fit_axis_height | strip }}</span>
                        <span class="size-guide-modal__corner-weight">{{ fit_axis_weight | strip }}</span>
                      </span>
                    {% else %}
                      {{ fit_axis_weight | strip }}
                    {% endif %}
                  </th>
                  <th>{% if fit_head %}{{ fit_head.settings.col_1 }}{% else %}{{ section.settings.size_guide_height_1 }}{% endif %}</th>
                  <th>{% if fit_head %}{{ fit_head.settings.col_2 }}{% else %}{{ section.settings.size_guide_height_2 }}{% endif %}</th>
                  <th>{% if fit_head %}{{ fit_head.settings.col_3 }}{% else %}{{ section.settings.size_guide_height_3 }}{% endif %}</th>
                  <th>{% if fit_head %}{{ fit_head.settings.col_4 }}{% else %}{{ section.settings.size_guide_height_4 }}{% endif %}</th>
                  <th>{% if fit_head %}{{ fit_head.settings.col_5 }}{% else %}{{ section.settings.size_guide_height_5 }}{% endif %}</th>
                </tr>
              </thead>
              <tbody>
                {% for row in fit_blocks %}
                  <tr {{ row.shopify_attributes }}>
                    <td>{{ row.settings.weight }}</td>
                    <td>{{ row.settings.col_1 }}</td>
                    <td>{{ row.settings.col_2 }}</td>
                    <td>{{ row.settings.col_3 }}</td>
                    <td>{{ row.settings.col_4 }}</td>
                    <td>{{ row.settings.col_5 }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      {% endif %}
      {% if section.settings.size_guide_note != blank %}
        <div class="size-guide-modal__note">{{ section.settings.size_guide_note | newline_to_br }}</div>
      {% endif %}
    </div>
  </div>
</modal-dialog>
{% endif %}
